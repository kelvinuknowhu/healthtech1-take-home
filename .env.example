# Copy to .env for local development: cp .env.example .env
# Postgres is published on 5433 (not 5432) to avoid clashing with any
# Postgres you may already run locally.
DATABASE_URL=postgres://takehome:takehome@localhost:5433/takehome

PORT=3000
LOG_LEVEL=info

# --- Pipeline tuning -------------------------------------------------------
# How often the form processor and email relay poll for due work.
WORKER_INTERVAL_MS=1000
# How many forms/emails a single worker tick claims at once.
WORKER_BATCH_SIZE=10
# Attempts before a form or email is parked in DEAD_LETTER.
MAX_ATTEMPTS=5
# Exponential backoff: min(BACKOFF_BASE_MS * 2^attempts, BACKOFF_MAX_MS) + jitter.
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=300000
# A form stuck in PROCESSING longer than this is assumed to be from a crashed
# worker and is reclaimed as PENDING.
PROCESSING_LEASE_MS=60000

# --- Dead-letter sweeper ---------------------------------------------------
# Safety net that retries DEAD_LETTER forms. Nightly in production; the
# interval is configurable so it can be exercised quickly in a demo.
SWEEP_INTERVAL_MS=86400000
# Also retry FAILED_VALIDATION forms, so a deployed schema fix heals
# unattended without anyone calling /retry.
SWEEP_INCLUDES_VALIDATION_FAILURES=true

# --- Notification email ----------------------------------------------------
EMAIL_TO=happyforms@bots.com
EMAIL_FROM=noreply@healthtech1.example.com

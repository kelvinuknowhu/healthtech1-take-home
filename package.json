{
  "name": "take-home-test",
  "version": "1.0.0",
  "description": "Take home test project",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node-dev --transpile-only --exit-child src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
